{
    "name": "contenir/cache-laminas-mvc",
    "description": "Laminas MVC adapter for contenir/cache — MvcEvent page-cache listener driven by the standard pagecache config.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1 || ^8.2 || ^8.3",
        "laminas/laminas-cache": "^3.0 || ^4.0",
        "laminas/laminas-eventmanager": "^3.0",
        "laminas/laminas-http": "^2.0",
        "laminas/laminas-mvc": "^3.4",
        "laminas/laminas-servicemanager": "^3.0 || ^4.0"
    },
    "require-dev": {
        "laminas/laminas-authentication": "^2.0",
        "laminas/laminas-cache-storage-adapter-memory": "^2.0",
        "phpunit/phpunit": "^11.0",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "suggest": {
        "laminas/laminas-authentication": "Optional. When a Laminas\\Authentication\\AuthenticationServiceInterface is registered in the container, the listener mixes the authenticated identity's role into the cache key so two roles never share a cached page."
    },
    "autoload": {
        "psr-4": { "Contenir\\Cache\\Laminas\\Mvc\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Contenir\\Cache\\Laminas\\Mvc\\Tests\\": "tests/" }
    },
    "extra": {
        "laminas": {
            "module": "Contenir\\Cache\\Laminas\\Mvc"
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs": "phpcs",
        "cs-fix": "phpcbf"
    },
    "config": {
        "sort-packages": true
    }
}
